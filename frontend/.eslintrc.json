{
  "root": true,
  "extends": ["next/core-web-vitals", "eslint-config-prettier"],
  "rules": {
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "prefer-const": "error"
  },
  "overrides": [
    {
      "files": ["tests/**/*.{ts,tsx}"],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules/", ".next/", "next-env.d.ts"]
}
