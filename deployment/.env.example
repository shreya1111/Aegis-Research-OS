# =============================================================================
# Aegis Research OS — configuration contract
#
# Copy to `.env` in the repository root and fill in real values:
#   cp deployment/.env.example .env
#
# `.env` is gitignored and must never be committed. Only variables introduced by
# a completed phase appear here; later phases extend this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Application (Phase 0)
# -----------------------------------------------------------------------------
# development | staging | production. Controls docs exposure and HSTS.
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Comma-separated list of browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Service ports (Phase 0) — host-side bindings used by Docker Compose
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL (Phase 0) — single store for relational data, vectors, and FTS
# -----------------------------------------------------------------------------
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-in-every-environment
POSTGRES_DB=aegis
# Host-side port for docker-compose.dev.yml. Defaults to 15432 (not 5432) to
# avoid colliding with a Postgres instance already running on the host.
POSTGRES_PORT=15432
# Async SQLAlchemy DSN. Inside Compose the host is the service name `postgres`
# on its container-internal port 5432, regardless of the host-side mapping above.
POSTGRES_URL=postgresql+asyncpg://aegis:change-me-in-every-environment@postgres:5432/aegis

# -----------------------------------------------------------------------------
# Redis (Phase 0) — cache, rate limiting, run status
# -----------------------------------------------------------------------------
# Host-side port for docker-compose.dev.yml. Defaults to 16379 (not 6379) to
# avoid colliding with a Redis instance already running on the host.
REDIS_PORT=16379
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Authentication (Phase 1) — design §9.1, §9.2
# -----------------------------------------------------------------------------
# Symmetric JWT signing secret. MUST be overridden with a long random value
# outside development; startup fails in production if left at its default.
JWT_SECRET=insecure-development-secret-change-me
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
# Minimum accepted plaintext password length at registration.
PASSWORD_MIN_LENGTH=10

# -----------------------------------------------------------------------------
# Rate limiting (Phase 1) — design §9.6, Redis-backed
# -----------------------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=5

# -----------------------------------------------------------------------------
# Document ingestion (Phase 3) — design §8.1, §9.5
# -----------------------------------------------------------------------------
# Maximum accepted upload size in bytes (default 100 MB).
MAX_UPLOAD_BYTES=104857600
# Comma-separated MIME allow-list. Only PDF and DOCX are supported in the MVP.
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
# Documents beyond this page count are rejected before processing.
MAX_UPLOAD_PAGES=500

# -----------------------------------------------------------------------------
# Embeddings (Phase 3) — design §4.3
# -----------------------------------------------------------------------------
# sentence-transformers model id. Changing this invalidates all stored vectors
# and must match EMBEDDING_DIMENSIONS below (and the build-arg in the backend
# image). Re-embed existing chunks after changing it.
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Vector column dimensionality, fixed by EMBEDDING_MODEL (all-MiniLM-L6-v2=384).
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32

# -----------------------------------------------------------------------------
# Chunking (Phase 3) — design §8.3
# -----------------------------------------------------------------------------
# Token-aware chunk size and overlap. Overlap must be smaller than the size.
CHUNK_TOKENS=700
CHUNK_OVERLAP_TOKENS=100

# -----------------------------------------------------------------------------
# OCR (Phase 3) — design §8.2 "the OCR honesty rule"
# -----------------------------------------------------------------------------
OCR_ENABLED=true
# Mean per-word OCR confidence (0-100) below which a document is flagged
# low-confidence rather than silently ingested.
OCR_CONFIDENCE_THRESHOLD=60
# A page with fewer extractable characters than this is treated as scanned and
# sent to the OCR fallback.
OCR_TRIGGER_CHAR_THRESHOLD=20

# -----------------------------------------------------------------------------
# LLM provider (Phase 4) — design §4.1
# -----------------------------------------------------------------------------
# openai | gemini | sambanova. Switching providers is a configuration change;
# it never touches agent or business logic.
LLM_PROVIDER=sambanova
LLM_API_KEY=
# Real model name per tier: `fast` backs high-volume, low-judgement agents;
# `strong` backs planning/composition/review.
LLM_MODEL_FAST=Meta-Llama-3.1-8B-Instruct
LLM_MODEL_STRONG=Meta-Llama-3.3-70B-Instruct
LLM_BASE_URL=https://api.sambanova.ai/v1
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# Circuit breaker: consecutive failures before a provider trips open, and how
# long it stays open before a retry is allowed again.
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RESET_SECONDS=30
# Estimated cost per 1K tokens (USD) for SambaNova models
# Based on Meta-Llama-3.1-8B-Instruct pricing (fast tier)
LLM_COST_PER_1K_INPUT_TOKENS=0.0001
LLM_COST_PER_1K_OUTPUT_TOKENS=0.0002
# TTL for cached LLM responses (design §6.8).
LLM_CACHE_TTL_SECONDS=21600

# -----------------------------------------------------------------------------
# Retrieval / hybrid search (Phase 4) — design §4.2, §8.6, §8.7
# -----------------------------------------------------------------------------
RETRIEVAL_TOP_K=40
RETRIEVAL_TOP_N=8
# RRF constant `k` in `score = Σ 1/(k + rank_i)`.
RETRIEVAL_RRF_K=60
# Cross-encoder re-ranking is the most expensive retrieval step; toggleable so
# its precision/latency trade-off is measurable.
RETRIEVAL_RERANK_ENABLED=false
RETRIEVAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Citation validation retries at most this many times before the answer is
# accepted with a warning flag.
CITATION_MAX_REGENERATION_ATTEMPTS=3
# Per-minute query rate limit, keyed per user — bounds LLM cost exhaustion.
RATE_LIMIT_QUERY_PER_MINUTE=20

# -----------------------------------------------------------------------------
# External academic sources (Phase 5) — design §4.6, §4.7, §8.6
# -----------------------------------------------------------------------------
# Optional; a dead/unconfigured provider fails soft (empty result + trace
# warning), never fatal to the run.
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
WEB_SEARCH_API_KEY=
EXTERNAL_SOURCE_TIMEOUT_SECONDS=15
EXTERNAL_SOURCE_CACHE_TTL_SECONDS=21600
EXTERNAL_SOURCE_MAX_RESULTS=5

# -----------------------------------------------------------------------------
# Agent orchestration (Phase 5) — design §4.6
# -----------------------------------------------------------------------------
# The Critic's retry edges fire at most this many times per run (design §4.6
# rule 2: "the cap lives in the state, not in a prompt").
AGENT_MAX_RETRIES=1
# TTL for the `run:{run_id}` Redis status key backing the trace panel.
AGENT_RUN_STATUS_TTL_SECONDS=3600
# Per-request cap on subtasks the Supervisor may create, bounding worst-case
# cost for a single query.
AGENT_MAX_SUBTASKS=6

# -----------------------------------------------------------------------------
# Frontend (Phase 0/1)
# -----------------------------------------------------------------------------
# Browser-visible backend base URL. Non-sensitive by definition: never place API
# keys behind a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side (Next.js process) backend base URL, used by Server Components.
# Set to the backend's Compose service name; NOT read from .env directly — it
# is set inline in docker-compose.dev.yml / docker-compose.prod.yml because it
# must always be the in-network address, never the host-exposed one.
# API_INTERNAL_URL=http://backend:8000
